# =========================================================
# Python .gitignore
# =========================================================

# 虚拟环境
.venv/
venv/
env/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 环境变量（可能包含密钥）
.env

# IDE 配置（如果不需要共享的话）
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# 临时脚本
*.bat
tmp/
temp/

# Office/Excel 临时文件（打开文件时生成的锁文件，别提交）
~$*

# 识图代理：API Key 配置文件（含密钥，不入库）
识图代理/config.json

# =========================================================
# 个人数据（不入库）
# =========================================================

# 学习记录表（含附件）
学习记录表/

# DeepSeek 对话记录存档
DeepSeek对话记录/

# 考研根据地（目标/数据/导师信息）
考研/

# 专业课（课程笔记/实验数据）
专业课/
