# =========================================================
# Python .gitignore
# =========================================================

# 虚拟环境
.venv/
venv/
env/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 环境变量（可能包含密钥）
.env

# IDE 配置（如果不需要共享的话）
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# 临时脚本
*.bat
tmp/
temp/

# =========================================================
# 个人数据（不入库）
# =========================================================

# 学习记录表（含附件）
学习记录表/

# DeepSeek 对话记录存档
DeepSeek对话记录/
